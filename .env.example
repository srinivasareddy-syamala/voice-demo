# --- GoHighLevel (Settings > Private Integrations > create token) ---
# Scopes: voice-ai-agents.write, voice-ai-agents.readonly, contacts.write
#   + for appointment booking: voice-ai-agent-goals.write, calendars.readonly, calendars/events.write,
#     opportunities.readonly, opportunities.write
GHL_API_KEY=

# Settings > Business Profile > "Location ID" (also in the URL: /location/<THIS_ID>/...)
GHL_LOCATION_ID=

# AI Agents > Voice AI > open your agent > ID in the URL. Must be the agent linked to the widget below.
GHL_AGENT_ID=

# Version header for Voice AI endpoints
GHL_VOICE_API_VERSION=v3

# --- How visitors reach the agent ---
# The chat + call widget (6abf5919cb9ce9d3ea4df163) is set in main.py (WIDGET_ID), not here.
# Optional: agent's phone number, used only if the widget can't load
GHL_AGENT_PHONE=

CORS_ORIGINS=*
BRAND_NAME=Pragna AI
# WhatsApp number shown in the agent widget
WHATSAPP_NUMBER=+44 7446 952720
# Website screenshot inside the phone preview comes from thum.io.
# Leave empty for the free tier (desktop layout). Paid key "<id>-<secret>" gives a phone-layout screenshot.
THUM_IO_AUTH=
# 1 = open the chat widget automatically inside the phone, 0 = show only its launcher button
WIDGET_AUTO_OPEN=1

# --- Appointment booking during the demo call (appointment in the GHL calendar + opportunity) ---
# 1 = on, 0 = off
BOOKING_ENABLED=1
# Public https address of this app, e.g. https://demo.pragna.ai  (GHL's voice agent calls it to book).
# Leave empty to use the address the visitor opened the page on.
PUBLIC_URL=
# Leave these three empty to let the app pick: the first active calendar, the first pipeline and its first stage
# (names containing "demo" / "appointment" are preferred). Fill them to choose exactly.
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Used when the visitor's browser does not tell us its timezone
DEFAULT_TIMEZONE=Europe/London
