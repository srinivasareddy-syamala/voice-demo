# --- GoHighLevel (Settings > Private Integrations > create token) ---
# Scopes: voice-ai-agents.write, voice-ai-agents.readonly, contacts.write
#   + for appointments (book / change / cancel): voice-ai-agent-goals.write, calendars.readonly,
#     calendars/events.write, opportunities.readonly, opportunities.write, contacts.readonly
#   + for the text chat in the widget: conversation-ai.readonly, conversation-ai.write, calendars/events.readonly
#   Check what works: https://<your address>/api/booking/check?loc=<GHL_LOCATION_ID>
GHL_API_KEY=

# Settings > Business Profile > "Location ID" (also in the URL: /location/<THIS_ID>/...)
GHL_LOCATION_ID=

# AI Agents > Voice AI > open your agent > ID in the URL. Must be the agent linked to the widget below.
GHL_AGENT_ID=

# Version header for Voice AI endpoints
GHL_VOICE_API_VERSION=v3

# --- How visitors reach the agent ---
# The chat + call widget (6abf5919cb9ce9d3ea4df163) is set in main.py (WIDGET_ID), not here.
# Optional: agent's phone number, used only if the widget can't load
GHL_AGENT_PHONE=

CORS_ORIGINS=*
BRAND_NAME=Pragna AI
# WhatsApp number shown in the agent widget
WHATSAPP_NUMBER=+44 7446 952720
# Website screenshot inside the phone preview comes from thum.io.
# Leave empty for the free tier (desktop layout). Paid key "<id>-<secret>" gives a phone-layout screenshot.
THUM_IO_AUTH=
# 1 = open the chat widget automatically inside the phone, 0 = show only its launcher button
WIDGET_AUTO_OPEN=1

# --- Appointment booking during the demo call (appointment in the GHL calendar + opportunity) ---
# 1 = on, 0 = off
BOOKING_ENABLED=1
# Public https address of this app, e.g. https://demo.pragna.ai  (GHL's voice agent calls it to book).
# Leave empty to use the address the visitor opened the page on.
PUBLIC_URL=
# Leave these three empty to let the app pick: the first active calendar, the first pipeline and its first stage
# (names containing "demo" / "appointment" are preferred). Fill them to choose exactly.
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Used when the visitor's browser does not tell us its timezone
DEFAULT_TIMEZONE=Europe/London

# --- Appointment email to the customer (sent by GHL after the call: booked / moved / cancelled) ---
# Needs the token scopes conversations/message.write and conversations/message.readonly (delivery status). The From address's domain must be set up for sending in
# GHL (Settings > Email Services); if GHL refuses it, the email goes from the account's default address instead.
BOOKING_EMAIL_ENABLED=1
BOOKING_EMAIL_FROM=pragna1@angaluri.com
# Seconds after the last change before it is sent (it is sent at once when the visitor closes the page)
BOOKING_EMAIL_DELAY=300

# --- Text chat in the widget ("Chat via Live Chat" / "Chat via SMS/Email") ---
# That chat is answered by GHL's Conversation AI bot, not by the voice agent.
# 1 = on every form submission the app writes the visitor's company into the bot, sets it to auto-pilot on
#     Live Chat + Web Chat and switches on its appointment booking (book / reschedule / cancel). 0 = leave the bot alone.
CHAT_AGENT_ENABLED=1
# Leave empty to use the account's primary Conversation AI bot (a new one is created if the account has none).
# The bot's previous settings are saved once in .demo_state.json ("chat" > "backup").
GHL_CHAT_AGENT_ID=

# --- Lines: how many visitors can run a demo at the same time ---
# A line = one GHL voice agent + its own chat widget. Two lines are built in (main.py, DEFAULT_LINES):
#   6abdf3955deba8d1c1f3ac30 : 6abf5919cb9ce9d3ea4df163     and     6ac51060e7267112e69b5de7 : 6ac51135f1d5945734fe5e9f
# To add more: duplicate the agent and the widget in GHL, point the new widget at the new agent, then list ALL pairs:
#   GHL_LINES=agentId:widgetId,agentId:widgetId,agentId:widgetId
GHL_LINES=
# When every line is busy, visitors wait in a queue ("Please wait, the line is busy").
# With people waiting, a visitor keeps a line for this many seconds; their page then shows "session ended".
LINE_HOLD_SECONDS=420
